[Unit]
Description=eRepairShop WooCommerce order snapshot
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/usr/bin/flock -n /run/lock/punktepass-webshop-orders.lock /usr/bin/php /var/www/punktepass.de/wp-content/plugins/punktepass/tools/ppv-webshop-orders-snapshot.php
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadOnlyPaths=/var/www/shop.erepairshop.de/public /var/www/punktepass.de
ReadWritePaths=/var/lib/punktepass

